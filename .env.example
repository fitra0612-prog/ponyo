# =============================================================================
# Konfigurasi AI Lokal Ollama (100% Offline & Bebas Kuota)
# =============================================================================
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
CHAT_MODEL_NAME=qwen2.5:3b
VLM_MODEL=moondream:latest
QWEN_FAST_MODEL=qwen2.5:3b
QWEN_FALLBACK_MODEL=qwen2.5:3b
QWEN_ENABLED=true

# Masukkan ID Live Streaming YouTube Anda di sini
# Contoh URL: https://www.youtube.com/watch?v=AbCdEfGhIjK -> ID adalah AbCdEfGhIjK
# Kosongkan atau isi 'test' untuk mode simulasi interaktif lewat terminal
YOUTUBE_VIDEO_ID=

# Pilihan suara Edge-TTS (Default: id-ID-GadisNeural)
TTS_VOICE=id-ID-GadisNeural
# Kecepatan bicara (+10% untuk tempo ceria lincah)
TTS_RATE=+10%
# Nada suara anak kecil perempuan natural (+35Hz)
TTS_PITCH=+35Hz

# Warna latar belakang untuk OBS Chroma Key: GREEN, MAGENTA, BLUE, atau BLACK
CHROMA_MODE=GREEN

# Auto-yapping: campuran komentar layar dan celotehan playful spontan.
ENABLE_AUTO_YAP=true
YAP_INTERVAL=25
# 0.0-1.0; default 0.35 berarti sekitar 35% yapping tidak bergantung pada layar.
YAP_PLAYFUL_CHANCE=0.35

# Saweria (opsional; signature wajib jika stream key diisi)
# Default aman: hanya menerima webhook dari komputer ini.
SAWERIA_ENABLED=true
SAWERIA_HOST=127.0.0.1
SAWERIA_PORT=49225
SAWERIA_STREAM_KEY=

# Catur (opsional; isi path executable Stockfish lokal bila ingin mengaktifkan coach)
ENABLE_CHESS_COACH=false
STOCKFISH_PATH=
CHESS_COACH_DEPTH=15
CHESS_AUTO_PLAY=false

# Model Piper lokal; path default relatif ke folder project
PIPER_MODEL_PATH=models/piper/id_ID-news_tts-medium.onnx
PIPER_CONFIG_PATH=models/piper/id_ID-news_tts-medium.onnx.json
PIPER_PITCH_FACTOR=1.20
